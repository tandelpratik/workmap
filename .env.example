# Environment configuration.
#
# Copy to .env for local development. Never commit .env, and never put a real
# credential in this file. Validated at startup by config/env.ts.

# Deployment environment: development | preview | production
# Kept separate from NODE_ENV, which cannot distinguish preview from production.
APP_ENV=development

# PostgreSQL connections (ADR-0006). These two are easy to swap by mistake, and
# the mistake is quiet: both appear to work.
#
#   DATABASE_URL         POOLED.  Used by the application.
#   DIRECT_DATABASE_URL  DIRECT.  Used by migrations only.
#
# On Neon the pooled host contains "-pooler" and the direct host does not:
#   pooled  ep-example-123456-pooler.<region>.aws.neon.tech
#   direct  ep-example-123456.<region>.aws.neon.tech
#
# Getting this backwards means the application opens a connection per serverless
# invocation and exhausts the connection limit, while migrations run through a
# pooler where some DDL does not execute correctly.
#
# Prefer sslmode=verify-full over sslmode=require. Current pg treats them the
# same, but pg 9 will weaken "require" to skip certificate verification.
#
# DATABASE_URL is optional in development; the health endpoint then reports
# "not_configured". It is required in preview and production.
#
# DATABASE_URL=postgresql://user:password@ep-example-pooler.ap-southeast-2.aws.neon.tech/dbname?sslmode=verify-full&channel_binding=require
# DIRECT_DATABASE_URL=postgresql://user:password@ep-example.ap-southeast-2.aws.neon.tech/dbname?sslmode=verify-full&channel_binding=require

# Enables the development-only synthetic job source.
# MUST remain false in production. A production process with this set to true
# refuses to start, because synthetic records are fixtures and must never be
# served to the public (ADR-0009).
ALLOW_SYNTHETIC_SOURCES=false

# debug | info | warn | error
LOG_LEVEL=info

# Shared secret protecting manual ingestion triggers and admin routes.
# Minimum 32 characters. Required once those routes exist (ADR-0005).
# OPERATIONS_SECRET=
