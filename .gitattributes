# Normalise line endings so the repository is identical across platforms.
* text=auto eol=lf

# Binary assets must never be line-ending normalised.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary

# Generated geometry artefacts: large, machine-produced, diff-noisy.
*.topojson -diff
*.geojson -diff
