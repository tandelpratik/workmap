# Normalise line endings so the repository is identical across platforms.
* text=auto eol=lf

# Binary assets must never be line-ending normalised.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary

# Generated geometry artefacts: large, machine-produced, diff-noisy.
*.topojson -diff
*.geojson -diff

# Generated TopoJSON is large and machine-produced.
*.topo.json -diff

# Captured third-party responses, stored exactly as the server sent them.
# Normalising their line endings would mean the parser tests assert against a
# rewritten copy rather than the real page.
tests/fixtures/**/*.html -text
